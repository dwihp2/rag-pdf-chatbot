+-type CodeBlockFallbackProps = HTMLAttributes<HTMLDivElement>;
+-
+-const CodeBlockFallback = ({ children, ...props }: CodeBlockFallbackProps) => (
+-  <div {...props}>
+-    <pre className="w-full">
+-      <code>
+-        {children
+-          ?.toString()
+-          .split('\n')
+-          .map((line, i) => (
+-            <span className="line" key={i}>
+-              {line}
+-            </span>
+-          ))}
+-      </code>
+-    </pre>
+-  </div>
+-);
