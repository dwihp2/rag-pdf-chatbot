+++      mimeType: file.type || "application/pdf",
+++      status: "processing",
+++    },
+++  });
+++
+++  // Process async — in production, use a queue
+++  try {
+++    const { chunks } = await documentProcessor.processPDF(file);
+++    await vectorService.addDocuments(
