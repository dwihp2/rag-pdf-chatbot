+       WHERE d.status = 'completed'
+         AND 1 - (dc.embedding <=> $1::vector) > $2
+       ORDER BY dc.embedding <=> $1::vector
+       LIMIT $3`,
+      embeddingStr,
+      threshold,
+      limit
