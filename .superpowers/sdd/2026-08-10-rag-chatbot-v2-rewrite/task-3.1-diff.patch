+    // Deduplicate by document — keep highest-scoring chunk per document
+    const seen = new Set<string>();
+    const deduped = results.filter((r) => {
+      if (seen.has(r.documentId)) return false;
+      seen.add(r.documentId);
+      return true;
+    });
